# MajorDoMo virtual host (nginx only).
#
# The project is deployed on nginx: all rewrite and access rules live in this
# file, and no per-directory configuration should be added anywhere else.
#
# Usage:
#   cp nginx.conf.sample /etc/nginx/sites-available/majordomo
#   # adjust root, server_name and the php-fpm socket below
#   ln -s /etc/nginx/sites-available/majordomo /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# ---------------------------------------------------------------------------
# Layout (see docs/project-structure.md)
# ---------------------------------------------------------------------------
#   <project>/                 PHP entry points (index/admin/nf/api/404),
#                              modules/, lib/, templates/, cms/, 3rdparty/
#   <project>/public/assets/   all static resources, published as /assets/
#
# Why `root` points at the project root and not at public/:
#   the marketplace installs modules together with their PHP endpoints
#   (modules/<name>/*.php) and entry points rely on relative includes
#   ('./config.php'). So public/ is the static directory served through the
#   /assets/ alias, not the document root. Moving entry points into public/ is
#   a separate stage that requires reworking the module ecosystem.
#
# URL types:
#   /assets/...              static from public/assets (canonical)
#   /css|/js|/img/...        301 to /assets/... (old links and scenes)
#   /3rdparty/<lib>/         301 to /assets/vendor/<lib>/ for browser libs;
#                            other 3rdparty packages (PHP libs) are served as before
#   /templates/<m>/*.css|js  301 to /assets/modules/<m>/*
#   /panel/...               admin through nf.php
#   anything else            real file, otherwise nf.php/index.php

server {
    listen 127.0.0.1:80;
    server_name example.com www.example.com localhost;

    root /var/www/example/data/www/example.com;

    index index.php index.html index.htm;
    charset utf-8;
    autoindex off;

    # --- Access protection -------------------------------------------------
    # These paths must never be served directly.
    location = /config.php { deny all; }
    location = /debmes.txt { deny all; }
    # Let's Encrypt HTTP-01 validation must stay reachable.
    location ^~ /.well-known/acme-challenge/ { allow all; }
    # Dotfiles and dot-directories (.git, .gitkeep, .htpasswd, elFinder .tmp).
    location ~ /\. { deny all; }
    location ~* \.(htaccess|htpasswd|ini|phps|fla|sql|log|sh|py)$ { deny all; }

    # lib/ is include-only PHP: never serve it directly.
    location ^~ /lib/ { deny all; }

    # templates/*.html is include-only markup.
    location ~* ^/templates/.*\.html$ { deny all; }

    # UI component/page templates are include-only PHP.
    location ^~ /templates/ui/ { deny all; }
    location ^~ /templates/ui_kit/ { deny all; }

    # public/ is the source for /assets/ only. Serving it directly would
    # create a second canonical URL for every asset.
    location ^~ /public/ { deny all; }

    # --- Static assets (public/assets -> /assets/) -------------------------
    # `^~` keeps the generic cache/static regex locations below from winning.
    location ^~ /assets/ {
        alias /var/www/example/data/www/example.com/public/assets/;
        expires 30d;
        access_log off;
    }

    # --- Legacy asset URLs: permanent redirects to /assets/ ----------------
    # Old themes, cached admin pages and user scenes keep working through 301.
    location ~ ^/(css|js|img)/(.+)$ {
        return 301 /assets/$1/$2$is_args$args;
    }

    # Browser libraries moved out of 3rdparty (PHP libraries stay there).
    location ~ ^/3rdparty/(bootstrap|bootstrap-datetimepicker|duration-picker|fancybox|jquery|jquery\.toast|jquerymobile|long-press-event|moment)/(.*)$ {
        return 301 /assets/vendor/$1/$2$is_args$args;
    }

    # Module page CSS/JS moved out of templates/ (markup stays there).
    location ~ ^/templates/([a-z0-9_-]+)/(.+\.(?:css|js))$ {
        return 301 /assets/modules/$1/$2$is_args$args;
    }

    # --- Friendly URL routing ---------------------------------------------
    # Admin shell and admin pretty URLs (/panel/, /panel/classes.html, ...).
    # `^~` wins over the generic *.html location below, so every admin route
    # is resolved by nf.php and the shared route table in lib/admin_router.php.
    location = /panel {
        return 301 /panel/;
    }
    location ^~ /panel/ {
        try_files $uri $uri/ /nf.php?$query_string;
    }

    # Styled 404 page for nginx-generated errors and unknown *.html routes.
    # The request is executed by the generic PHP location below; no exact
    # location is declared here so fastcgi_pass is not bypassed.
    error_page 404 /404.php;

    # /.../pda -> /popup/pda.html
    location ~* pda$ {
        return 302 /popup/pda.html;
    }

    # /api/... -> /api.php
    location ^~ /api/ {
        rewrite ^ /api.php last;
    }

    # Long-lived cache for media files.
    location ~* \.(gif|jpe?g|png|svg|webp|ico|ogg|mp3|mp4|mkv|flv|swf|wmv|asf|asx|wma|wax|wmx|wm)$ {
        expires 7d;
        add_header Cache-Control "public";
    }

    # /module/app_mediabrowser.* -> nf.php when no real file/directory exists.
    location ~* ^/module/app_mediabrowser\..*$ {
        try_files $uri $uri/ /nf.php?$query_string;
    }

    # *.html / *.xml -> nf.php when no real file/directory exists.
    location ~* \.(html|xml)$ {
        try_files $uri $uri/ /nf.php?$query_string;
    }

    # Everything else: real files first, then the application entry point.
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ [^/]\.php(/|$) {
        include /etc/nginx/fastcgi_params;
        fastcgi_pass unix:/var/run/php/php-fpm.sock;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;

        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param SCRIPT_NAME $fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param HTTPS $http_x_forwarded_proto if_not_empty;

        fastcgi_read_timeout 240;
    }
}