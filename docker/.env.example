# ---------------------------------------------------------------------------
#  Переменные docker-стенда MajorDoMo (только отладка).
#
#  Скопируйте в docker/.env и запускайте:
#      docker compose --env-file docker/.env up -d --build
#
#  Без этого файла compose использует значения по умолчанию из
#  docker-compose.yml: admin / majordomo, порт 80, legacy-дамп.
# ---------------------------------------------------------------------------

# Порт, который выходит наружу. Внутри контейнера nginx всегда слушает 80.
MJD_HTTP_PORT=80

# Публичный адрес стенда. Для доступа с телефона по локальной сети укажите
# IP компьютера, а не localhost: иначе WebSocket отклонит Origin.
# Пример: MJD_BASE_URL=http://192.168.1.50
MJD_BASE_URL=http://localhost

MJD_TIMEZONE=Europe/Moscow
MJD_SITE_TIMEZONE=Europe/Moscow
MJD_SITE_LANGUAGE=ru
MJD_THEME=dark

# MariaDB. Пароль приложения и root-пароль различаются намеренно: root нужен
# только контейнеру db и ручной диагностике.
MJD_DB_NAME=majordomo
MJD_DB_USER=majordomo
MJD_DB_PASSWORD=majordomo
MJD_DB_ROOT_PASSWORD=majordomo-root

# legacy — старый дамп docs/dev/db_terminal.sql + миграции (по умолчанию);
# clean  — чистая схема lib/core/Install/schema.sql;
# none   — пустая база, мастер /install.php.
MJD_DB_SEED=legacy

# 1 — приложение не выполняет DROP DATABASE/DROP SCHEMA. Не выключайте без
# причины: именно это защищает стенд от случайной потери базы.
MJD_DB_PROTECT_DROP=1

# Учётная запись администратора. Пароль задаётся только при первом запуске
# (или при MJD_ADMIN_RESET_PASSWORD=1).
MJD_ADMIN_USER=admin
MJD_ADMIN_PASSWORD=majordomo
MJD_ADMIN_NAME=Docker Admin
MJD_ADMIN_RESET_PASSWORD=0

# 1 — при старте применить миграции и настроить MQTT/админа.
MJD_RUN_MIGRATIONS=1

# 1 — перезаписать .env при следующем старте. Обычно не нужно.
MJD_FORCE_ENV=0

# 1 — принудительно вернуть MQTT на встроенный mosquitto, даже если в панели
# был указан другой брокер. 0 — не трогать настройку после первого запуска.
MJD_MQTT_FORCE_CONFIG=0
