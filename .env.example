# ============================================================================
#  MajorDoMo configuration
# ============================================================================
#  Скопируйте файл в .env и заполните значения:
#      cp .env.example .env          (Linux)
#      copy .env.example .env        (Windows)
#
#  .env не коммитится и не должен попадать в веб-доступ.
#  Первичную настройку можно пройти в браузере: /install.php.
#  Мастер сам запишет .env и сделает резервную копию; после изменения вручную:
#      php tools/config.php clear    — сбросить кэш
#      перезапустить циклы           — они держат конфигурацию в памяти
#
#  Формат: KEY=value. Значения в кавычках сохраняют пробелы и `#`:
#      DB_PASSWORD="p#ss word"
#  Подстановка ${VAR} не поддерживается.
# ============================================================================

# ── База данных ─────────────────────────────────────────────────────────────
# Хост MySQL/MariaDB. Варианты: localhost | 127.0.0.1 | db (docker).
DB_HOST=localhost

# Порт. Пусто = порт по умолчанию (3306).
DB_PORT=

# Имя базы и пользователь.
DB_NAME=db_terminal
DB_USER=root

# Пароль. Если содержит #, пробел или $ — заключайте в кавычки.
DB_PASSWORD=

# ── Пути ────────────────────────────────────────────────────────────────────
# DOC_ROOT, ROOT и SERVER_ROOT вычисляются автоматически от каталога проекта.
# Меняйте SERVER_ROOT только если mysql/ffmpeg лежат в нестандартном месте.
# SERVER_ROOT=/var/www

# Относительно корня проекта. Обычно не меняются.
DIR_TEMPLATES=./templates/
DIR_MODULES=./modules/

# Путь приложения в URL. Для установки в подкаталог: /majordomo/
ROOTHTML=/

# Каталог сессий. Пусто — var/sessions внутри проекта.
# Если php-fpm фиксирует session.save_path через php_admin_value, ядро само
# работает по этому пути: билет WebSocket запоминает фактический каталог.
# Ключ нужен только для принудительного переопределения.
# SESSION_SAVE_PATH=/var/lib/php/sessions

# Публичный адрес. Нужен для ссылок, API и OAuth.
# Варианты: http://127.0.0.1:80 | https://home.example.com
BASE_URL=http://127.0.0.1:80

# ── Исполняемые файлы ───────────────────────────────────────────────────────
# PHP для фоновых циклов. Пусто = текущий бинарник PHP (PHP_BINARY).
# PATH_TO_PHP=/usr/bin/php8.4

# mysqldump для резервных копий.
PATH_TO_MYSQLDUMP=mysqldump

# Необязательные интеграции. Если ключа нет — соответствующая функция выключена.
# PATH_TO_FFMPEG=ffmpeg
# PYTHON_PATH=python
# AUDIO_PLAYER=omxplayer --no-osd

# ── Проект ──────────────────────────────────────────────────────────────────
PROJECT_TITLE=MajorDoMo

# 1 — показывать отладочные страницы и HTML-комментарии шаблонов, 0 — не показывать.
DEBUG_MODE=0

# production | development | testing. Влияет только на код, который сам читает APP_ENV.
APP_ENV=production

# Часовой пояс по умолчанию для CLI и ранних ошибок.
# Для веб-запросов его перекрывает настройка SITE_TIMEZONE из админки.
TIMEZONE=UTC

# ── Обновления ──────────────────────────────────────────────────────────────
# Базовый URL репозитория. Пусто — обновления через Git отключены.
GIT_URL=https://github.com/SmoKE585/majordomo

# MASTER_UPDATE_URL, PROJECT_URL и PROJECT_COMMIT_URL вычисляются из GIT_URL.
# Переопределяйте только при нестандартной схеме обновлений.
# MASTER_UPDATE_URL=
# PROJECT_URL=
# PROJECT_COMMIT_URL=

# Канал обновлений (используется модулем saverestore).
# UPDATES_REPOSITORY_NAME=smarthome

# Дополнительные источники обновлений: JSON-объект { "url": "подпись" }.
# ADITIONAL_GIT_URLS={}

# ── Деплой ──────────────────────────────────────────────────────────────────
# Инструменты обновления. Пустое значение — искать в PATH.
# DEPLOY_COMPOSER=composer
# DEPLOY_NODE=node
# DEPLOY_NPM=npm

# always — npm run build при каждом обновлении; auto — npm ci только при
# изменённом package-lock.json, build при каждом; never — не собирать.
# DEPLOY_ASSETS=always

# Имя systemd-службы. По умолчанию majordomo-<пользователь сайта>.
# DEPLOY_SERVICE=majordomo-mjdm_smart15_usr

# Перезапускать службу после успешного обновления.
# DEPLOY_RESTART=1

# Таймаут composer/npm, секунд.
# DEPLOY_TIMEOUT=900

# ── Фоновые циклы ───────────────────────────────────────────────────────────
# Список циклов через запятую. Пусто — значение по умолчанию.
# RESTART_THREADS=cycle_main.php,cycle_states.php,cycle_websockets.php

# Ждать запуска main-цикла перед стартом остальных: 0 | 1.
# WAIT_FOR_MAIN_CYCLE=1
# Watchdog: seconds without heartbeat / without the first heartbeat after starting.
# CYCLE_HEARTBEAT_TIMEOUT=120
# CYCLE_STARTUP_TIMEOUT=180
# Per-cycle timeout for slow market modules or long-running backups (seconds):
# CYCLE_TIMEOUTS={"cycle_periodical_db_save":900}

# Снижать количество фоновых процессов: 0 | 1.
# LOWER_BACKGROUND_PROCESSES=1

# Число параллельных исполнителей core_runtime. 1 — прежняя последовательная
# обработка; больше 1 — независимые сущности параллельно, произвольный PHP
# (сценарии, API, события модулей) остаётся в последовательной полосе.
# CORE_WORKERS=3

# Ускорение панели (подстановка partLoad в ссылки): 0 | 1.
# ENABLE_PANEL_ACCELERATION=1

# Ошибка постановки уведомления в очередь должна выбрасываться из setGlobal(): 0 | 1.
# По умолчанию 0: значение сохраняется, ошибка дедуплицируется в system_errors.
# PROPERTY_DELIVERY_STRICT=0

# ── Логирование ─────────────────────────────────────────────────────────────
# Каталог логов. Пусто — cms/debmes.
# LOG_DIRECTORY=

# Максимальный размер файла лога, МБ (0 — без ограничения).
# LOG_MAX_SIZE=2

# Писать stdout/stderr циклов в файлы: 0 | 1.
# LOG_CYCLES=1

# Устарело: PHP-диагностика из error_reporting всегда пишется в errors.log.
# LOG_PHP_WARNINGS=1

# Подробный лог вызовов методов: 0 | 1.
# VERBOSE_LOG=0

# Исключения для VERBOSE_LOG через запятую.
# VERBOSE_LOG_IGNORE=.checkstate,ThisComputer.uptime

# Хранить историю ошибок системы: 0 | 1.
# SETTINGS_ERRORS_KEEP_HISTORY=1

# ── Кэш, история, производительность ────────────────────────────────────────
# Максимальный размер значения в кэше (символы).
# CACHE_VALUE_MAX_SIZE=255

# Отключить оптимизацию записи истории: 0 | 1.
# HISTORY_NO_OPTIMIZE=1

# Хранить историю в отдельных таблицах: 0 | 1.
# SEPARATE_HISTORY_STORAGE=1

# Журнал изменений свойств включён всегда и не отключается.
# Срок хранения записей журнала в днях. 0 — хранить бессрочно.
# PROPERTY_AUDIT_RETENTION_DAYS=30

# Логировать изменения данных объектов: 0 | 1.
# TRACK_DATA_CHANGES=0

# Исключения TRACK_DATA_CHANGES через запятую.
# TRACK_DATA_CHANGES_IGNORE=cycle_, clockchime, uptime, WSClientsTotal

# Сроки хранения файлов, дней.
# LOG_FILES_EXPIRE=5
# BACKUP_FILES_EXPIRE=10
# CACHED_FILES_EXPIRE=30

# ── Redis ───────────────────────────────────────────────────────────────────
# Хост Redis. false — Redis выключен (используется SQL-кэш).
# Варианты: false | 127.0.0.1 | redis
# USE_REDIS=false

# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TIMEOUT=2.5

# Пространство имён ключей. Должно быть стабильным между обновлениями.
# REDIS_PREFIX=majordomo:home:

# ── Сеть и прокси ───────────────────────────────────────────────────────────
# Локальный IP хоста (для проверки «своя сеть»).
# LOCAL_IP=127.0.0.1

# Домашняя сеть: 192.168.0.* | 192.168.0.0/24 | несколько через запятую.
# Используется для обхода прокси и доступа к API без токена.
# Если не задана, API считает локальными частные IPv4, IPv6 ULA/link-local и loopback.
# HOME_NETWORK=192.168.0.*

# Прокси для исходящих запросов: host:port.
# USE_PROXY=127.0.0.1:8888
# USE_PROXY_AUTH=user:password

# Каким прокси можно доверять X-Forwarded-For (IP/CIDR через запятую).
# Для API за reverse proxy укажите только реальные адреса прокси.
# Сам адрес доверенного прокси без адреса клиента не даёт доступ без токена.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ── MQTT ────────────────────────────────────────────────────────────────────
# Максимальный размер входящего пакета, байт; таймаут его полной передачи, сек.
MQTT_MAX_PACKET_BYTES=1048576
MQTT_PACKET_TIMEOUT=5

# Быстрый путь MQTT: приём пишет в Redis, состояние топиков переносится в MySQL
# с отставанием до секунды. Работает только при включённом Redis и phpredis.
# MQTT_ASYNC_ENABLED=1
# Число параллельных обработчиков (порядок внутри одной сущности сохраняется).
# MQTT_HANDLERS=3
# Аренда обработчика и число повторов события.
# MQTT_HANDLER_LEASE=120
# MQTT_MAX_ATTEMPTS=5

# WebSocket — обязательная часть ядра без настроек подключения.
# Публичный путь /ws использует порт сайта; внутренний сервер — 127.0.0.1:8001.
