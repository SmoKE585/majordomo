{
  "name": "majordomo-admin",
  "private": true,
  "version": "1.0.0",
  "description": "MajorDoMo admin panel asset build",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.codeeditor.config.js && vite build --config vite.charts.config.js && vite build --config vite.codehighlight.config.js && node tools/check-admin-assets.mjs",
    "build:admin": "vite build && node tools/check-admin-assets.mjs",
    "build:editor": "vite build --config vite.codeeditor.config.js && node tools/check-admin-assets.mjs",
    "build:charts": "vite build --config vite.charts.config.js && node tools/check-admin-assets.mjs",
    "build:highlight": "vite build --config vite.codehighlight.config.js && node tools/check-admin-assets.mjs",
    "watch": "vite build --watch",
    "watch:editor": "vite build --config vite.codeeditor.config.js --watch",
    "watch:charts": "vite build --config vite.charts.config.js --watch",
    "watch:highlight": "vite build --config vite.codehighlight.config.js --watch",
    "check": "node --check resources/js/app.js",
    "icons": "node tools/generate-icon-catalog.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fancyapps/fancybox": "3.5.7",
    "@lezer/highlight": "^1.2.5",
    "@tabler/icons-webfont": "^3.49.0",
    "alpinejs": "^3.17.4",
    "apexcharts": "^4.7.0",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "highlight.js": "^11.12.0",
    "html-duration-picker": "2.4.0",
    "jquery": "3.7.1",
    "jquery-migrate": "3.4.1",
    "tom-select": "2.4.3"
  },
  "devDependencies": {
    "vite": "^8.0.0"
  }
}
