[Unit]
Description=MajorDoMo
# Do not use Requires=mysql.service/nginx.service here: systemd will stop
# MajorDoMo when those services are restarted and will not automatically bring
# it back after a dependency stop.
After=network-online.target mysql.service mariadb.service
Wants=network-online.target mysql.service

[Service]
Type=simple
# Служба не должна работать от root: это пользователь сайта FastPanel.
User=www-data
Group=www-data
WorkingDirectory=/var/www/majordomo
# Необязательная пауза на старте, если MySQL поднимается одновременно.
# ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do mysqladmin ping -h 127.0.0.1 --silent && exit 0; sleep 2; done; exit 1'
ExecStart=/usr/bin/php /var/www/majordomo/cycle.php
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
