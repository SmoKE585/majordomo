# MajorDoMo — nginx для may-13.ru (адаптация под pretty URL /panel/...)
#
# Это эталонный конфиг для текущего домена: сохранены subdomain-логика,
# auth_basic, proxy на 8002 и локальный server на 127.0.0.1:80.
#
# Что исправлено относительно исходного конфига:
#   1. location /config.php и /debmes.txt были обычными prefix-location и
#      проигрывали regex-локациям `~ \.php$` и статике — то есть фактически
#      не работали. Теперь это `^~` / `=`.
#   2. Добавлены запреты /lib/, templates/*.html, templates/ui/, templates/ui_kit/,
#      dotfiles и опасных расширений — как в docs/deploy/nginx.conf.sample.
#   3. Добавлены явные /panel и /panel/ (301 на канонический слеш + try_files в nf.php).
#   4. `if (!-e $request_filename) rewrite` заменён на try_files.
#   5. PHP-локация: fastcgi_split_path_info/PATH_INFO, HTTPS=on, таймауты и
#      client_max_body_size (бэкапы/восстановление/обновления).
#   6. Стилизованная 404 для статики (PHP/nf.php 404 не перехватываются,
#      чтобы не сломать JSON-404 для AJAX).
#   7. /api/ вынесен в ^~ location с rewrite ... last.
#
# После замены: nginx -t && systemctl reload nginx
#
# ВАЖНО: проверьте срок действия сертификата
#   openssl x509 -in /var/www/httpd-cert/may-13.ru_2025-10-12-15-55_01.crt -noout -enddate
# Имя файла содержит дату выпуска 2025-10-12; если автопродление не обновило
# файл, HTTPS будет отдавать просроченный сертификат.

server {
    server_name may-13.ru www.may-13.ru;
    listen 192.168.1.100:443 ssl;

    ssl_certificate "/var/www/httpd-cert/may-13.ru_2025-10-12-15-55_01.crt";
    ssl_certificate_key "/var/www/httpd-cert/may-13.ru_2025-10-12-15-55_01.key";

    http2 on;

    charset utf-8;

    auth_basic "closed site";
    auth_basic_user_file /var/www/majordomo_usr/data/www/may-13.ru/.httpauth;

    gzip on;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/css text/xml application/javascript text/plain application/json image/svg+xml image/x-icon;
    gzip_comp_level 1;

    set $subdomain "";
    if ($host ~* ^([a-z0-9-\.]+)\.may-13.ru) {
        set $subdomain $1;
    }
    if ($host ~* ^www.may-13.ru) {
        set $subdomain "";
    }

    set $root_path /var/www/majordomo_usr/data/www/may-13.ru/$subdomain;
    index index.php;

    root $root_path;
    disable_symlinks if_not_owner from=$root_path;

    # --- Красивые URL админки ------------------------------------------
    # Без этого /panel отдал бы dashboard на неканоническом URL.
    location = /panel {
        return 301 /panel/;
    }

    # ^~ важен: он запрещает regex-локациям (php/статика) перехватывать
    # /panel/... и гарантирует, что все админ-маршруты уходят в nf.php.
    location ^~ /panel/ {
        try_files $uri $uri/ /nf.php?$query_string;
    }

    # --- API ------------------------------------------------------------
    location ^~ /api/ {
        rewrite ^ /api.php last;
    }

    # --- Защита include-only путей -------------------------------------
    # ^~ обязателен: обычный prefix проигрывает regex `\.php$`, а exact не
    # покрывает /config.php/... (PATH_INFO). ^~ закрывает и то, и другое.
    location ^~ /config.php {
        deny all;
    }

    location = /debmes.txt {
        deny all;
    }

    # lib/ — только include, наружу не отдаём.
    location ^~ /lib/ {
        deny all;
    }

    # UI-компоненты и секции UI Kit — только include.
    location ^~ /templates/ui/ {
        deny all;
    }

    location ^~ /templates/ui_kit/ {
        deny all;
    }

    # Остальные templates/*.html — include-only разметка.
    location ~* ^/templates/.*\.html$ {
        deny all;
    }

    # Dotfiles (.git, .httpauth, ...), кроме ACME-челленджей.
    location ~ /\.(?!well-known) {
        deny all;
    }

    # Служебные расширения, которые не должны скачиваться напрямую.
    location ~* \.(htaccess|htpasswd|ini|phps|fla|sql|log|sh|py)$ {
        deny all;
    }

    # --- Статика: public/assets -> /assets/ ------------------------------
    # ^~ обязателен: иначе regex-локации ниже (php/статика) перехватят путь.
    location ^~ /assets/ {
        alias $root_path/public/assets/;
        expires 30d;
        access_log off;
    }

    # public/ — источник для /assets/, напрямую не отдаём: иначе у каждого
    # файла появляется второй канонический URL.
    location ^~ /public/ {
        deny all;
    }

    # --- Старые пути ассетов: 301 на /assets/ ---------------------------
    # Старые темы, закэшированные страницы админки и пользовательские сцены
    # продолжают работать через постоянный редирект.
    location ~ ^/(css|js|img)/(.+)$ {
        return 301 /assets/$1/$2$is_args$args;
    }

    # Браузерные библиотеки переехали из 3rdparty в public/assets/vendor
    # (PHP-библиотеки остались в 3rdparty).
    location ~ ^/3rdparty/(bootstrap|bootstrap-datetimepicker|duration-picker|fancybox|jquery|jquery\.toast|jquerymobile|long-press-event|moment)/(.*)$ {
        return 301 /assets/vendor/$1/$2$is_args$args;
    }

    # CSS/JS страниц модулей переехали из templates/ в public/assets/modules.
    location ~ ^/templates/([a-z0-9_-]+)/(.+\.(?:css|js))$ {
        return 301 /assets/modules/$1/$2$is_args$args;
    }

    # --- PHP ------------------------------------------------------------
    # [^/]\.php(/|$) + split_path_info — чтобы работали и /api.php/...,
    # и обычные /admin.php, /nf.php.
    location ~ [^/]\.php(/|$) {
        include /etc/nginx/fastcgi_params;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;

        fastcgi_pass unix:/var/run/may-13.ru.sock;

        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param PATH_INFO $fastcgi_path_info;

        # PHP должен видеть, что запрос пришёл по HTTPS.
        fastcgi_param HTTPS on;

        # Обновления/бэкапы/восстановление могут идти дольше 60 секунд.
        fastcgi_read_timeout 600s;
        fastcgi_send_timeout 600s;

        # Загрузка архивов восстановления/обновления. Если fastpanel задаёт
        # client_max_body_size на уровне server, это значение переопределит его
        # только для PHP-запросов.
        client_max_body_size 512m;
    }

    # --- Статика --------------------------------------------------------
    location ~* ^.+\.(jpg|jpeg|gif|png|svg|js|css|mp3|ogg|mpeg|avi|zip|gz|bz2|rar|swf|ico|7z|doc|docx|map|ogg|otf|pdf|tff|tif|txt|wav|webp|woff|woff2|xls|xlsx|xml)$ {
        try_files $uri =404;
        # Стилизованная 404 только для статики. PHP/nf.php 404 не трогаем:
        # иначе JSON-404 для AJAX мог бы превратиться в HTML.
        error_page 404 /404.php;
        expires 30d;
    }

    # --- Всё остальное --------------------------------------------------
    location / {
        rewrite pda$ /popup/pda.html redirect;

        # Публичные friendly URL (pages.html, popup/..., ajax/..., module/...)
        # и всё, чего нет файлом, разбирает nf.php.
        try_files $uri $uri/ /nf.php?$query_string;
    }

    include "/etc/nginx/fastpanel2-sites/majordomo_usr/may-13.ru.includes";
    include /etc/nginx/fastpanel2-includes/*.conf;

    error_log /dev/null crit;
    access_log off;
}

server {
    listen 192.168.1.100:8002 ssl;
    server_name may-13.ru www.may-13.ru;

    ssl_certificate "/var/www/httpd-cert/may-13.ru_2025-10-12-15-55_01.crt";
    ssl_certificate_key "/var/www/httpd-cert/may-13.ru_2025-10-12-15-55_01.key";

    location /majordomo {
        proxy_pass http://127.0.0.1:8001/majordomo;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_read_timeout 3600;
        proxy_send_timeout 3600;

        proxy_buffering off;
        proxy_cache_bypass $http_upgrade;
    }

    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;

        proxy_read_timeout 3600;
        proxy_send_timeout 3600;

        proxy_buffering off;
        proxy_cache_bypass $http_upgrade;
    }

    error_log off;
    access_log off;
}

server {
    server_name may-13.ru www.may-13.ru;

    listen 192.168.1.100:80;
    return 301 https://$host$request_uri;

    error_log /dev/null crit;
    access_log off;
}

# Локальный вход (например, для внутренних запросов приложения).
server {
    listen 127.0.0.1:80;

    charset utf-8;

    root /var/www/majordomo_usr/data/www/may-13.ru;
    index index.php;

    location = /panel {
        return 301 /panel/;
    }

    location ^~ /panel/ {
        try_files $uri $uri/ /nf.php?$query_string;
    }

    location ^~ /api/ {
        rewrite ^ /api.php last;
    }

    location ^~ /config.php {
        deny all;
    }

    location = /debmes.txt {
        deny all;
    }

    location ^~ /lib/ {
        deny all;
    }

    location ^~ /templates/ui/ {
        deny all;
    }

    location ^~ /templates/ui_kit/ {
        deny all;
    }

    location ~* ^/templates/.*\.html$ {
        deny all;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }

    location ~* \.(htaccess|htpasswd|ini|phps|fla|sql|log|sh|py)$ {
        deny all;
    }

    # --- Статика: public/assets -> /assets/ ------------------------------
    location ^~ /assets/ {
        alias /var/www/majordomo_usr/data/www/may-13.ru/public/assets/;
        expires 30d;
        access_log off;
    }

    location ^~ /public/ {
        deny all;
    }

    # --- Старые пути ассетов: 301 на /assets/ ---------------------------
    location ~ ^/(css|js|img)/(.+)$ {
        return 301 /assets/$1/$2$is_args$args;
    }

    location ~ ^/3rdparty/(bootstrap|bootstrap-datetimepicker|duration-picker|fancybox|jquery|jquery\.toast|jquerymobile|long-press-event|moment)/(.*)$ {
        return 301 /assets/vendor/$1/$2$is_args$args;
    }

    location ~ ^/templates/([a-z0-9_-]+)/(.+\.(?:css|js))$ {
        return 301 /assets/modules/$1/$2$is_args$args;
    }

    location ~ [^/]\.php(/|$) {
        include /etc/nginx/fastcgi_params;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;

        fastcgi_pass unix:/var/run/may-13.ru.sock;

        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param PATH_INFO $fastcgi_path_info;

        fastcgi_read_timeout 600s;
        fastcgi_send_timeout 600s;
        client_max_body_size 512m;
    }

    location ~* ^.+\.(jpg|jpeg|gif|png|svg|js|css|mp3|ogg|mpeg|avi|zip|gz|bz2|rar|swf|ico|7z|doc|docx|map|ogg|otf|pdf|tff|tif|txt|wav|webp|woff|woff2|xls|xlsx|xml)$ {
        try_files $uri =404;
        # Стилизованная 404 только для статики. PHP/nf.php 404 не трогаем:
        # иначе JSON-404 для AJAX мог бы превратиться в HTML.
        error_page 404 /404.php;
        expires 30d;
    }

    location / {
        rewrite pda$ /popup/pda.html redirect;
        try_files $uri $uri/ /nf.php?$query_string;
    }

    error_log /var/log/nginx/localhost.error.log;
    access_log /var/log/nginx/localhost.access.log;
}
