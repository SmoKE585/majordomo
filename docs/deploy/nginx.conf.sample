# MajorDoMo virtual host (nginx only).
#
# The project is deployed on nginx: all rewrite and access rules live in this
# file, and no per-directory configuration should be added anywhere else.
#
# Usage:
#   cp docs/deploy/nginx.conf.sample /etc/nginx/sites-available/majordomo
#   # adjust root, server_name and the php-fpm socket below
#   ln -s /etc/nginx/sites-available/majordomo /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# ---------------------------------------------------------------------------
# Layout: public/ is the document root (Laravel-like)
# ---------------------------------------------------------------------------
#   <project>/public/     index.php, admin.php, nf.php, api.php, 404.php,
#                         favicon.ico, robots.txt, assets/
#   <project>/            application code: bootstrap.php, config.php, lib/,
#                         modules/, templates/, cms/, 3rdparty/, scripts/,
#                         objects/, pChart/, docs/
#
# Only public/ is reachable by default; config.php, lib/, load_settings.php,
# bootstrap.php, cycle.php and dev_server.php are outside the document root.
#
# Directories that must stay reachable by their old URLs are mounted from the
# project root through explicit `root` overrides, so those URLs keep working:
#
#   /cms/...      media (avatars, images, sounds); cached/debmes denied
#   /modules/...  module PHP endpoints (autosave, iframe workers, widgets)
#   /objects/...  object scripts
#   /pChart/...   property charts
#   /scripts/...  cycle web triggers
#   /3rdparty/... elFinder and bundled libraries
#   /docs/...     documentation (sql/log denied)
#
# Old URLs are redirected:
#   /css|/js|/img/...          301 -> /assets/...
#   /3rdparty/<browser-lib>/... 301 -> /assets/vendor/<browser-lib>/...
#   /templates/<module>/*.css|js 301 -> /assets/modules/<module>/...
#   /public/...                301 -> /...            (old docroot prefix)
#   /rc/...                    301 -> /panel/         (feature removed)

server {
    listen 127.0.0.1:80;
    server_name example.com www.example.com localhost;

    root /var/www/example/data/www/example.com/public;
    index index.php;

    charset utf-8;
    autoindex off;

    # --- Public entry points ----------------------------------------------
    location = /panel {
        return 301 /panel/;
    }
    location ^~ /panel/ {
        try_files $uri $uri/ /nf.php?$query_string;
    }
    location ^~ /api/ {
        rewrite ^ /api.php last;
    }
    error_page 404 /404.php;

    # --- Static assets -----------------------------------------------------
    location ^~ /assets/ {
        expires 30d;
        access_log off;
    }

    # --- Legacy asset URLs: permanent redirects to /assets/ ----------------
    location ~ ^/(css|js|img)/(.+)$ {
        return 301 /assets/$1/$2$is_args$args;
    }
    location ~ ^/3rdparty/(bootstrap|bootstrap-datetimepicker|duration-picker|fancybox|jquery|jquery\.toast|jquerymobile|long-press-event|moment)/(.*)$ {
        return 301 /assets/vendor/$1/$2$is_args$args;
    }
    location ~ ^/templates/([a-z0-9_-]+)/(.+\.(?:css|js))$ {
        return 301 /assets/modules/$1/$2$is_args$args;
    }
    location ~ ^/public/(.*)$ {
        return 301 /$1$is_args$args;
    }

    # --- Removed feature ---------------------------------------------------
    location = /rc {
        return 301 /panel/;
    }
    location ^~ /rc/ {
        return 301 /panel/;
    }

    # --- Application directories outside the document root -----------------
    # `^~` wins over regex locations, therefore PHP must be handled by a
    # nested location inside every block. Otherwise nginx would serve the
    # source of modules/*.php instead of executing it.
    location ^~ /modules/ {
        root /var/www/example/data/www/example.com;
        location ~ [^/]\.php(/|$) {
            include /etc/nginx/fastcgi_params;
            fastcgi_split_path_info ^(.+\.php)(/.*)$;
            fastcgi_pass unix:/var/run/php/php-fpm.sock;

            fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
            fastcgi_param DOCUMENT_ROOT /var/www/example/data/www/example.com/public;
            fastcgi_param PATH_INFO $fastcgi_path_info;

            fastcgi_read_timeout 240;
        }
    }

    location ^~ /objects/ {
        root /var/www/example/data/www/example.com;
        location ~ [^/]\.php(/|$) {
            include /etc/nginx/fastcgi_params;
            fastcgi_split_path_info ^(.+\.php)(/.*)$;
            fastcgi_pass unix:/var/run/php/php-fpm.sock;

            fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
            fastcgi_param DOCUMENT_ROOT /var/www/example/data/www/example.com/public;
            fastcgi_param PATH_INFO $fastcgi_path_info;

            fastcgi_read_timeout 240;
        }
    }

    location ^~ /pChart/ {
        root /var/www/example/data/www/example.com;
        location ~ [^/]\.php(/|$) {
            include /etc/nginx/fastcgi_params;
            fastcgi_split_path_info ^(.+\.php)(/.*)$;
            fastcgi_pass unix:/var/run/php/php-fpm.sock;

            fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
            fastcgi_param DOCUMENT_ROOT /var/www/example/data/www/example.com/public;
            fastcgi_param PATH_INFO $fastcgi_path_info;

            fastcgi_read_timeout 240;
        }
    }

    location ^~ /scripts/ {
        root /var/www/example/data/www/example.com;
        location ~ [^/]\.php(/|$) {
            include /etc/nginx/fastcgi_params;
            fastcgi_split_path_info ^(.+\.php)(/.*)$;
            fastcgi_pass unix:/var/run/php/php-fpm.sock;

            fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
            fastcgi_param DOCUMENT_ROOT /var/www/example/data/www/example.com/public;
            fastcgi_param PATH_INFO $fastcgi_path_info;

            fastcgi_read_timeout 240;
        }
    }

    location ^~ /3rdparty/ {
        root /var/www/example/data/www/example.com;
        location ~ [^/]\.php(/|$) {
            include /etc/nginx/fastcgi_params;
            fastcgi_split_path_info ^(.+\.php)(/.*)$;
            fastcgi_pass unix:/var/run/php/php-fpm.sock;

            fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
            fastcgi_param DOCUMENT_ROOT /var/www/example/data/www/example.com/public;
            fastcgi_param PATH_INFO $fastcgi_path_info;

            fastcgi_read_timeout 240;
        }
        location ~* \.(sql|log|sh|py|ini|phps|fla|htaccess|htpasswd)$ { deny all; }
    }

    # Media only; runtime data (cache, logs, installed markers, backups) is private.
    location ^~ /cms/ {
        root /var/www/example/data/www/example.com;
        location ~ ^/cms/(cached|debmes|modules_installed|saverestore)/ { deny all; }
        location ~* \.(gif|jpe?g|png|svg|webp|ico)$ { expires 7d; }
    }

    # Documentation (UI Kit links to it). SQL dumps and scripts stay closed.
    location ^~ /docs/ {
        root /var/www/example/data/www/example.com;
        location ~* \.(sql|log|sh|py|ini|phps|fla)$ { deny all; }
    }

    # --- Access protection --------------------------------------------------
    location ~ /\. { deny all; }
    location ~* \.(htaccess|htpasswd|ini|phps|fla|sql|log|sh|py)$ { deny all; }

    # --- Cache and friendly URLs -------------------------------------------
    location ~* \.(gif|jpe?g|png|svg|webp|ico|ogg|mp3|mp4|mkv|flv|swf|wmv|asf|asx|wma|wax|wmx|wm)$ {
        expires 7d;
        add_header Cache-Control "public";
    }

    location ~* ^/module/app_mediabrowser\..*$ {
        try_files $uri $uri/ /nf.php?$query_string;
    }

    location ~* \.(html|xml)$ {
        try_files $uri $uri/ /nf.php?$query_string;
    }

    # --- Everything else ----------------------------------------------------
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # --- PHP from the document root ----------------------------------------
    location ~ [^/]\.php(/|$) {
        include /etc/nginx/fastcgi_params;
        fastcgi_pass unix:/var/run/php/php-fpm.sock;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;

        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param SCRIPT_NAME $fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param HTTPS $http_x_forwarded_proto if_not_empty;

        fastcgi_read_timeout 240;
    }
}