# MajorDoMo — пример nginx. 2026-10-22: входящие webhook в общей ветке /api/.
# Подставьте домен, сертификат, каталог проекта и сокет PHP-FPM.
# Авторизацию админки проверяет PHP; API и WS используют собственную проверку.
# WebSocket слушает только 127.0.0.1:8001, публичный адрес — /ws.
# 3rdparty/ и objects/ удалены; scripts/, packages/, vendor/ не публикуются.
#
# Публичные webhook — это /api/hooks/<секрет>. Отдельное правило для каждого
# входа не нужно: они входят в общий location /api/. Секрет находится в URI,
# поэтому он может попасть в access_log этого сервера и внешнего proxy.
# Однократно настройте маскирование, например (map кладётся в http{}):
#   map $request_uri $md_loggable_uri {
#       ~^/api/hooks/[a-f0-9]{64} /api/hooks/[redacted];
#       default                    $request_uri;
#   }
#   log_format md_redacted '$remote_addr - $remote_user [$time_local] '
#                          '"$request_method $md_loggable_uri $server_protocol" '
#                          '$status $body_bytes_sent "$http_referer" "$http_user_agent"';
#   access_log /var/log/nginx/example.access.log md_redacted;
# Приложение не может убрать секрет из журналов внешнего reverse proxy.
# Если внешний proxy закрывает все запросы до PHP, для /api/ нужно исключение.

server {
    listen 443 ssl;
    http2 on;
    server_name example.com www.example.com;
    ssl_certificate /etc/nginx/ssl/example.com.crt;
    ssl_certificate_key /etc/nginx/ssl/example.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    charset utf-8;
    root /var/www/example/data/www/example.com/public;
    index index.php;
    autoindex off;
    absolute_redirect off;
    auth_basic off;
    client_max_body_size 512m;

    # Общий публичный путь; авторизацию проверяет сервер WebSocket.
    location = /ws {
        proxy_pass http://127.0.0.1:8001/majordomo;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        # Сервер сверяет Origin с Host, X-Forwarded-Host и публичным адресом
        # проекта: если панель не передаёт Host, исходный домен всё равно нужен.
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-API-Key $http_x_api_key;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_buffering off;
        proxy_cache off;
        access_log off;
    }

    location = /install { return 302 /install.php; }
    location = /install/ { return 302 /install.php; }
    location = /panel { return 301 /panel/; }
    location ^~ /panel/ {
        try_files $uri $uri/ /nf.php?$query_string;
    }

    # Сохраняются метод, JSON и исходный URI, включая legacy /api.php/.
    # /api/hooks/<секрет> идёт сюда же: отдельные location для webhook не нужны.
    location ~ ^/api(?:\.php)?(?:/|$) {
        include /etc/nginx/fastcgi_params;
        fastcgi_pass unix:/var/run/php/php-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root/api.php;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param SCRIPT_NAME /api.php;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_param HTTPS $https if_not_empty;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_param HTTP_X_API_KEY $http_x_api_key;
        fastcgi_param HTTP_X_FORWARDED_FOR $http_x_forwarded_for;
        # Нужно для настраиваемого заголовка дополнительного секрета webhook.
        fastcgi_pass_request_headers on;
        fastcgi_intercept_errors off;
        fastcgi_next_upstream off;
        fastcgi_cache off;
        fastcgi_read_timeout 600s;
        fastcgi_send_timeout 600s;
        client_max_body_size 1m;
        error_page 413 = @majordomo_api_body_too_large;
    }

    location @majordomo_api_body_too_large {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Request-ID $request_id always;
        return 413 '{"ok":false,"error":{"code":"payload_too_large","message":"Request body exceeds 1 MiB","details":{}},"meta":{"request_id":"$request_id","generated_by":"nginx"}}';
    }

    error_page 404 /404.php;

    location ^~ /assets/ {
        location ~* (?:/\.|\.(?:php[0-9]*|phtml|phar|ini|sql|log|sh|py|bak)$) { return 404; }
        try_files $uri =404;
        expires 30d;
        access_log off;
    }

    # Редиректы ассетов стоят до запрета остальных файлов templates/.
    location ~ ^/(css|js|img)/(.+)$ {
        return 301 /assets/$1/$2$is_args$args;
    }
    location ~ ^/templates/([a-z0-9_-]+)/(.+\.(?:css|js))$ {
        return 301 /assets/modules/$1/$2$is_args$args;
    }
    location ~ ^/public/(.*)$ { return 301 /$1$is_args$args; }
    location = /rc { return 301 /panel/; }
    location ^~ /rc/ { return 301 /panel/; }

    # Эти каталоги не монтируются из корня приложения ни для LAN, ни извне.
    location ~ ^/(scripts|objects|3rdparty|packages|vendor)(/|$) {
        return 404;
    }
    location ~ ^/(lib|resources|templates|tests|tools|backup|var|node_modules|languages|src)(/|$) {
        return 404;
    }
    location ~ ^/(config\.php|bootstrap\.php|load_settings\.php|cycle\.php|dev_server\.php|majordomo|composer\.(json|lock)|package(-lock)?\.json)(/|$) {
        return 404;
    }
    location = /debmes.txt { return 404; }
    location ~ /\. { return 404; }
    location ~* \.(htaccess|htpasswd|ini|phps|fla|sql|log|sh|py|bak)$ { return 404; }

    # Рабочие PHP-входы установленных модулей сохраняются.
    location ^~ /modules/ {
        root /var/www/example/data/www/example.com;
        location ~ /\. { return 404; }
        location ~* \.(htaccess|htpasswd|ini|phps|sql|log|sh|py|bak)$ { return 404; }
        location ~* [^/]\.php(/|$) {
            fastcgi_split_path_info ^(.+?\.php)(/.*)$;
            set $md_path_info $fastcgi_path_info;
            try_files $fastcgi_script_name =404;
            include /etc/nginx/fastcgi_params;
            fastcgi_pass unix:/var/run/php/php-fpm.sock;
            fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
            fastcgi_param DOCUMENT_ROOT /var/www/example/data/www/example.com/public;
            fastcgi_param SCRIPT_NAME $fastcgi_script_name;
            fastcgi_param PATH_INFO $md_path_info;
            fastcgi_param HTTPS $https if_not_empty;
            fastcgi_param HTTP_AUTHORIZATION $http_authorization;
            fastcgi_param HTTP_X_API_KEY $http_x_api_key;
            fastcgi_param HTTP_X_FORWARDED_FOR $http_x_forwarded_for;
            fastcgi_read_timeout 600s;
            fastcgi_send_timeout 600s;
        }
        try_files $uri $uri/ =404;
    }

    # Из cms публикуются только медиа, без PHP и runtime-данных.
    location ^~ /cms/ {
        root /var/www/example/data/www/example.com;
        deny all;
        location ~ ^/cms/(cached|debmes|modules_installed|saverestore)/ { deny all; }
        location ~ /\. { deny all; }
        location ~* \.(gif|jpe?g|png|svg|webp|ico|ogg|mp3|wav|mp4|webm|pdf|woff2?|ttf|otf)$ {
            allow all;
            try_files $uri =404;
            expires 7d;
        }
    }

    location ^~ /docs/ {
        root /var/www/example/data/www/example.com;
        deny all;
        location ~ /\. { deny all; }
        location ~* \.(md|txt|pdf|gif|jpe?g|png|svg|webp|ico)$ {
            allow all;
            default_type text/plain;
            try_files $uri =404;
        }
    }

    location ~* ^/module/app_mediabrowser\..*$ {
        try_files $uri $uri/ /nf.php?$query_string;
    }
    location ~* \.(html|xml)$ {
        try_files $uri $uri/ /nf.php?$query_string;
    }

    location ~* [^/]\.php(/|$) {
        fastcgi_split_path_info ^(.+?\.php)(/.*)$;
        set $md_path_info $fastcgi_path_info;
        try_files $fastcgi_script_name =404;
        include /etc/nginx/fastcgi_params;
        fastcgi_pass unix:/var/run/php/php-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param SCRIPT_NAME $fastcgi_script_name;
        fastcgi_param PATH_INFO $md_path_info;
        fastcgi_param HTTPS $https if_not_empty;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_param HTTP_X_API_KEY $http_x_api_key;
        fastcgi_param HTTP_X_FORWARDED_FOR $http_x_forwarded_for;
        fastcgi_read_timeout 600s;
        fastcgi_send_timeout 600s;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
}

server {
    listen 80;
    server_name example.com www.example.com;
    return 301 https://$host$request_uri;
}
